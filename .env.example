# Copy to .env (git-ignored) for local dev. In production set these in EAS:
#   eas env:create --environment production --visibility sensitive ...
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Request signing. Both MUST hold the same value (32+ characters). The EXPO_PUBLIC_
# copy is inlined into the web bundle on purpose; see AGENTS.md "Request authentication".
API_SIGNING_SECRET=
EXPO_PUBLIC_API_SIGNING_SECRET=

# Session cookie. Server-only: never add an EXPO_PUBLIC_ copy. 32+ characters.
SESSION_COOKIE_SECRET=

# Comma-separated origins allowed to call /api (localhost is accepted only in development).
ALLOWED_ORIGINS=https://your-app.expo.app

# Demo login that accepts any name. Ignored in production builds.
DEMO_AUTH_ENABLED=false

# Only for native builds: absolute URL of the deployed API (web uses same-origin paths).
EXPO_PUBLIC_API_URL=
